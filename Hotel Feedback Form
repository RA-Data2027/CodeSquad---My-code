<!DOCTYPE html>
<!-- Tells the browser this is a modern HTML document. -->

<html lang="en">
<!-- The root of the page. lang="en" identifies the content as English. -->

<head>
  <!-- Information about the page goes in the head. -->

  <meta charset="UTF-8">
  <!-- Allows the page to display a wide range of characters correctly. -->

  <title>Hotel Feedback Form</title>
  <!-- Text shown in the browser tab. Change it for a different project. -->
</head>

<body>
  <!-- Visible page content starts here. -->

  <header>
    <!-- Introductory content for this page. -->

    <h1>Hotel Feedback Form</h1>
    <!-- The main heading of the page. -->

    <p>
      Thank you for staying with us. Please provide feedback on your recent
      stay.
    </p>
    <!-- Introductory paragraph. Change this text to suit your project. -->
  </header>

  <main>
    <!-- The primary content of the page. -->

    <form method="POST" action="https://hotel-feedback.freecodecamp.org">
      <!--
        form groups the fields that will be submitted.
        POST sends the form data in the request body.
        action is the destination that receives the data.
        For your own project, replace this lab URL with your own form endpoint.
        GET is another method, but it places form data in the URL.
      -->

      <fieldset>
        <!-- Groups related personal-information fields. -->

        <legend>Personal Information</legend>
        <!-- Gives this fieldset a title. -->

        <label for="full-name">Name (required):</label>
        <!--
          The label tells the user what to enter.
          for="full-name" must match the input's id="full-name".
        -->

        <input
          type="text"
          id="full-name"
          name="name"
          placeholder="e.g., John Doe"
          required
          size="20"
        >
        <!--
          type="text": accepts plain text.
          id="full-name": connects this input to its label.
          name="name": identifies this field in the submitted data.
          placeholder: shows an example while the field is empty.
          required: prevents normal submission when the field is empty.
          size="20": gives the field an approximate visible width.
          Alternative: use CSS for more control over the field's width.
        -->

        <label for="email">Email address (required):</label>
        <!-- for="email" matches the email input's id. -->

        <input
          type="email"
          id="email"
          name="email"
          placeholder="example@email.com"
          required
          size="20"
        >
        <!--
          type="email": expects an email address and enables browser validation.
          name="email": identifies this field in the submitted data.
          required: makes the field mandatory.
          The placeholder is a hint, not a replacement for the label.
        -->

        <label for="age">Age (optional):</label>
        <!-- This label is connected to id="age" below. -->

        <input type="number" id="age" name="age" min="3" max="100">
        <!--
          type="number": creates a numeric input.
          min="3" and max="100": set the permitted range.
          There is no required attribute, so the field is optional.
        -->
      </fieldset>

      <fieldset>
        <!-- Groups the two answers to one question. -->

        <legend>Was this your first time at our hotel?</legend>

        <input
          type="radio"
          id="yes-option"
          name="hotel-stay"
          value="yes"
        >
        <label for="yes-option">Yes</label>
        <!-- value="yes" is submitted if this radio button is chosen. -->

        <input
          type="radio"
          id="no-option"
          name="hotel-stay"
          value="no"
        >
        <label for="no-option">No</label>
        <!--
          Both radio buttons have name="hotel-stay".
          Sharing a name makes them one group, so only one can be selected.
          Their different id values connect them to different labels.
        -->
      </fieldset>

      <fieldset>
        <!-- Checkboxes allow the user to select multiple answers. -->

        <legend>
          Why did you choose to stay at our hotel? (Check all that apply)
        </legend>

        <input type="checkbox" id="ads" name="choice" value="ads">
        <label for="ads">Social Media Ads</label>

        <input
          type="checkbox"
          id="recommendation"
          name="choice"
          value="recommendation"
        >
        <label for="recommendation">Personal Recommendation</label>

        <input
          type="checkbox"
          id="location"
          name="choice"
          value="location"
        >
        <label for="location">Location</label>

        <input
          type="checkbox"
          id="reputation"
          name="choice"
          value="reputation"
          checked
        >
        <label for="reputation">Reputation</label>
        <!-- checked makes Reputation selected by default. -->

        <input
          type="checkbox"
          id="price"
          name="choice"
          value="price"
        >
        <label for="price">Price</label>

        <!--
          Each checkbox has a unique id and value.
          They share name="choice", but users can select several checkboxes.
          Only checked choices are included when the form is submitted.
        -->
      </fieldset>

      <fieldset>
        <!-- Groups the service and food ratings. -->

        <legend>Ratings</legend>

        <label for="service">How was the service?</label>

        <select id="service" name="service">
          <!-- A select element creates a dropdown menu. -->

          <option value="poor">Poor</option>
          <option value="satisfactory">Satisfactory</option>
          <option value="good">Good</option>
          <option value="very-good">Very Good</option>
          <option value="excellent" selected>Excellent</option>
          <!-- selected makes Excellent the default choice. -->
        </select>

        <label for="food">How was the food?</label>

        <select id="food" name="food">
          <option value="poor">Poor</option>
          <option value="satisfactory">Satisfactory</option>
          <option value="good">Good</option>
          <option value="very-good">Very Good</option>
          <option value="excellent" selected>Excellent</option>
        </select>

        <!--
          The text between option tags is what the user sees.
          The value attribute is what is submitted.
          Alternative: add a "Choose a rating" option instead of
          selecting Excellent by default.
        -->
      </fieldset>

      <label for="comments">Other Comments?</label>
      <!-- for="comments" matches the textarea's id. -->

      <textarea
        id="comments"
        name="comments"
        cols="30"
        rows="10"
      ></textarea>
      <!--
        textarea accepts multiple lines of text.
        cols="30" and rows="10" set its approximate visible size.
        Alternative: use CSS to control its size more flexibly.
        Keep both opening and closing textarea tags.
      -->

      <button type="submit">Submit</button>
      <!--
        Submits the form.
        Alternative: change the visible text to "Send Feedback".
        type="button" would not submit the form by itself.
      -->
    </form>
    <!-- End of the form. -->
  </main>

</body>
</html>
