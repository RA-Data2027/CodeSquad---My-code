<!DOCTYPE html>
<!-- Tells the browser this is a modern HTML document. -->

<html lang="en">
<!-- Starts the HTML document. lang="en" says the page is in English. -->

<head>
  <!-- Holds information about the page, not the visible table. -->

  <meta charset="UTF-8">
  <!-- Helps text characters display correctly. -->

  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <!-- Helps the page fit different screen sizes. -->

  <title>Book Catalog</title>
  <!-- The title shown in the browser tab. -->
</head>

<body>
  <!-- Visible page content starts here. -->

  <table>
    <!-- Starts a table for information organized in rows and columns. -->

    <thead>
      <!-- Groups the column headings. This lab requires one row here. -->

      <tr>
        <!-- Starts the header row. tr means "table row." -->

        <th>Title</th>
        <!-- th means "table header cell." This labels the first column. -->

        <th>Author</th>
        <!-- Labels the second column. -->

        <th>Genre</th>
        <!-- Labels the third column. -->

        <th>Publication Year</th>
        <!-- Labels the fourth column. -->
      </tr>
      <!-- Ends the header row. -->
    </thead>
    <!-- Ends the table head. -->

    <tbody>
      <!--
        Holds the book entries.
        This lab requires at least five tr rows inside tbody.
        Each book row must contain exactly four td cells, in this order:
        Title, Author, Genre, Publication Year.
      -->

      <tr>
        <!-- Book 1 -->
        <td>The Lantern Garden</td>
        <td>Mira Vale</td>
        <td>Fantasy</td>
        <td>2018</td>
      </tr>

      <tr>
        <!-- Book 2 -->
        <td>Signals from Tomorrow</td>
        <td>Jonah Reed</td>
        <td>Science Fiction</td>
        <td>2021</td>
      </tr>

      <tr>
        <!-- Book 3 -->
        <td>The Hidden Staircase</td>
        <td>Elena Brooks</td>
        <td>Mystery</td>
        <td>2016</td>
      </tr>

      <tr>
        <!-- Book 4 -->
        <td>Across the Blue Valley</td>
        <td>Amara Finch</td>
        <td>Adventure</td>
        <td>2020</td>
      </tr>

      <tr>
        <!-- Book 5 -->
        <td>Small Moments, Big Ideas</td>
        <td>Leo Hart</td>
        <td>Nonfiction</td>
        <td>2023</td>
      </tr>

      <!--
        td means "table data cell."
        Count the tr elements above: there are five book rows.
        If you add another book, add another tr with four td cells.
      -->
    </tbody>
    <!-- Ends the table body. -->

    <tfoot>
      <!-- Holds the table's footer. This lab requires one row here. -->

      <tr>
        <!-- Starts the footer row. -->

        <td colspan="4">Total Books: 5</td>
        <!--
          This is one td cell containing the total.
          colspan="4" makes it stretch across all four columns.
          The number 5 must match the number of book rows in tbody.
          If you add a sixth book, change this text to Total Books: 6.
        -->
      </tr>
    </tfoot>
    <!-- Ends the table footer. -->
  </table>
  <!-- Ends the table. -->
</body>
</html>
